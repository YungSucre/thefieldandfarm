---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";
import { CATEGORIES } from "../config";
import { createHash } from "node:crypto";
import { readFileSync } from "node:fs";

const articles = await getCollection("articles", ({ data }) => data.status === "published");
// dédup par CONTENU : les articles aux chemins hero différents mais MÊME fichier
// Pexels → cards identiques. Hash md5 du fichier pour ne garder que des images uniques.
const sorted = articles.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const seenHashes = new Set();
const latest: typeof sorted = [];
for (const a of sorted) {
  if (latest.length >= 6) break;
  const img = a.data.hero_image || "";
  if (!img) continue;
  if (!img.startsWith("http")) {
    try {
      const buf = readFileSync("public" + img);
      const h = createHash("md5").update(buf).digest("hex");
      if (seenHashes.has(h)) continue;
      seenHashes.add(h);
    } catch {
      /* fichier introuvable : on garde quand même */
    }
  }
  latest.push(a);
}
const byVertical = {};
const lastByVertical = {};
for (const a of articles) {
  byVertical[a.data.vertical] = (byVertical[a.data.vertical] || 0) + 1;
  const prev = lastByVertical[a.data.vertical];
  if (!prev || a.data.pubDate.valueOf() > prev.data.pubDate.valueOf()) {
    lastByVertical[a.data.vertical] = a;
  }
}
const total = articles.length;
const nVertical = CATEGORIES.reduce((n, c) => n + c.verticals.length, 0);
const year = new Date().getFullYear();
const fmtDate = (d: Date) =>
  new Intl.DateTimeFormat("en-US", { year: "numeric", month: "short", day: "numeric" }).format(d);
---

<BaseLayout title="The Field & Farm: Practical Guides for Gardeners and Small Farmers" description="Growing vegetables, raising livestock, soil and compost, food preservation, and farm business guides: 80+ topics across 8 families. Fact-first, current, practical.">
  <!-- Hero plein écran -->
  <section class="home-hero">
    <img class="home-hero-bg" src="/images/hero-home.jpg" alt="" fetchpriority="high" />
    <div class="home-hero-overlay"></div>
    <div class="home-hero-content">
      <p class="home-hero-eyebrow">For gardeners &amp; small farmers</p>
      <h1>Grow it. Raise it. Preserve it.</h1>
      <p class="home-hero-sub">
        Practical, honest guides on growing vegetables, raising livestock, building soil,
        and storing the harvest. Written by people who have made the mistakes, so you do not have to.
      </p>
      <div class="hero-ctas">
        <a class="btn" href="/guides/">Start with a guide</a>
        <a class="btn btn-ghost" href="#topics">Browse topics</a>
      </div>
    </div>
  </section>

  <!-- Ce que fait ce site -->
  <section class="section">
    <div class="section-head">
      <p class="eyebrow">What this field guide is</p>
      <h2>Answers for the questions that actually come up in the garden and the barn.</h2>
      <p>
        When to plant, how to fix yellow leaves, which breed to start with, how to store a
        harvest. {total} guide{total > 1 ? "s" : ""} published, {nVertical} topics, checked and dated.
      </p>
      <form action="/search/" method="get" role="search" style="display:flex;gap:0.6rem;max-width:34rem;margin-top:1.5rem;">
        <input name="q" type="search" placeholder="e.g. how to grow turnips, chicken coop…" autocomplete="off" aria-label="Search guides" style="flex:1;padding:0.7rem 1rem;font-size:0.95rem;background:#fffdf6;border:1px solid var(--line);border-radius:12px;color:var(--ink);" />
        <button type="submit" class="btn">Search</button>
      </form>
    </div>
  </section>

  <!-- Outils gratuits -->
  <section class="section" id="tools" style="padding-top:0;">
    <div class="section-head">
      <p class="eyebrow">Free tools</p>
      <h2>Calculators that save you the guesswork.</h2>
      <p>
        Precise, source-backed calculators for your exact ZIP code and climate —
        no sign-up, no email, free forever.
      </p>
    </div>
    <div class="tools-grid">
      <a class="tool-card" href="/calculators/planting-dates/">
        <span class="tool-status">Ready</span>
        <h3>Planting Dates by ZIP</h3>
        <p>
          Your last frost, first frost, and a 37-vegetable planting calendar —
          computed from 30 years of NOAA climate data for your exact ZIP code.
        </p>
        <span class="tool-cta">Open the calculator →</span>
      </a>
      <a class="tool-card" href="/calculators/soil-amendment/">
        <span class="tool-status">Ready</span>
        <h3>Soil Amendment Calculator</h3>
        <p>
          How much compost, lime, sulfur, or fertilizer for your beds — by size and
          soil type, from university extension rates.
        </p>
        <span class="tool-cta">Open the calculator →</span>
      </a>
      <a class="tool-card" href="/calculators/canning-times/">
        <span class="tool-status">Ready</span>
        <h3>Canning Times &amp; Pressure Chart</h3>
        <p>
          Safe water-bath and pressure-canning times for 40+ foods, with automatic
          altitude adjustments from the USDA guide.
        </p>
        <span class="tool-cta">Open the chart →</span>
      </a>
    </div>
  </section>

  <!-- Familles -->
  <section class="section" id="topics" style="padding-top:0;">
    <div class="section-head">
      <p class="eyebrow">Topics</p>
      <h2>Eight families, {nVertical} growing topics.</h2>
    </div>
    <div class="families">
      {CATEGORIES.map((cat, i) => (
        <a class="family-card" href={`/guides/${cat.verticals[0].id}/`}>
          <span class="fc-num">{String(i + 1).padStart(2, "0")}</span>
          <h3>{cat.name}</h3>
          <p>
            {cat.verticals.length} topics:{" "}
            {cat.verticals.slice(0, 4).map((v) => v.name).join(", ")}.
          </p>
        </a>
      ))}
    </div>
  </section>

  <!-- Derniers guides -->
  <section class="section" id="guides" style="padding-top:0;">
    <div class="section-head">
      <p class="eyebrow">Latest guides</p>
      <h2>Fresh from the field.</h2>
    </div>
    {total === 0 && (
      <div class="card"><strong>Launching soon.</strong> Our first guides are being prepared.</div>
    )}
    <div class="grid">
      {latest.map((a) => (
        <article class="article-card">
          {a.data.hero_image && (
            <a href={`/guides/${a.data.vertical}/${a.data.slug}/`}>
              <img class="thumb" src={a.data.hero_image} alt={a.data.hero_alt || a.data.title} loading="lazy" />
            </a>
          )}
          <div class="card-body">
            <span class="tag">{a.data.verticalName}</span>
            <h3><a href={`/guides/${a.data.vertical}/${a.data.slug}/`}>{a.data.title}</a></h3>
            <p class="excerpt">{a.data.description}</p>
            <p class="date">{fmtDate(a.data.pubDate)}</p>
          </div>
        </article>
      ))}
    </div>
  </section>

  <!-- Pourquoi -->
  <section class="section" style="padding-top:0;">
    <div class="section-head">
      <p class="eyebrow">Why these guides</p>
      <h2>Written for people with dirt under their nails.</h2>
    </div>
    <div class="why-grid">
      <div class="why-card">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 12l2 2 4-4" /><path d="M12 3l7 3v5c0 4.5-3 8-7 10-4-2-7-5.5-7-10V6l7-3z" /></svg>
        <h3>Fact-first, no fluff</h3>
        <p>Every guide answers one concrete question: when to plant, how to fix it, what actually works in the field.</p>
      </div>
      <div class="why-card">
        <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="5" width="18" height="16" rx="2" /><path d="M8 3v4M16 3v4M3 10h18" /></svg>
        <h3>Checked and dated</h3>
        <p>Planting dates, prices, and realistic yields, reviewed and dated on every guide. No recycled content.</p>
      </div>
      <div class="why-card">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 19V5a2 2 0 012-2h12a2 2 0 012 2v14" /><path d="M2 19h20" /><path d="M9 7h6M9 11h6M9 15h4" /></svg>
        <h3>Built for every crop</h3>
        <p>{nVertical} topics, from tomatoes to turkeys, organized so you land on the answer fast.</p>
      </div>
    </div>
  </section>

  <section class="section-soft">
    <p class="eyebrow">Who we write for</p>
    <h3 style="margin-top:0;">You, in the garden or the barn.</h3>
    <p style="margin-bottom:0;">
      If you grow food, raise animals, or want to, you face a specific set of practical
      questions: when to plant, how to improve the soil, what to feed the flock, how to
      store the harvest. We answer those questions with concrete, current information,
      checked and dated on every guide.
    </p>
  </section>
</BaseLayout>

---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";
import { VERTICALS } from "../../../config";
import hubIntros from "../../../data/hub_intros.json";

export async function getStaticPaths() {
  return VERTICALS.map((v) => ({ params: { vertical: v.id }, props: { v } }));
}

const { v } = Astro.props;
const articles = await getCollection("articles", ({ data }) => data.status === "published" && data.vertical === v.id);
const sorted = articles.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const intro =
  (hubIntros as Record<string, string>)[v.id] ||
  `Practical guides on growing, caring for, and getting the most from ${v.name.toLowerCase()}: planting, common problems, and the tools that actually help.`;
---

<BaseLayout title={`${v.name} Guides: The Field &amp; Farm`} description={`Practical guides on growing, caring for, and solving problems with ${v.name.toLowerCase()}: planting, varieties, tools, and troubleshooting.`}>
  <nav style="font-size:0.9rem;color:var(--muted);margin-bottom:1.5rem;">
    <a href="/">Home</a> › <a href="/guides/">Guides</a> › {v.name}
  </nav>
  <span class="eyebrow" style="display:inline-block;background:var(--accent-soft);color:var(--accent);font-size:0.8rem;font-weight:700;text-transform:uppercase;letter-spacing:0.06em;padding:0.35rem 0.8rem;border-radius:999px;margin-bottom:1.2rem;">{v.name}</span>
  <h1>{v.name} guides</h1>
  <p class="lead">{intro}</p>

  {sorted.length === 0 && (
    <div class="card"><strong>Coming soon.</strong> Guides for {v.name} owners are being prepared.</div>
  )}

  <div class="grid">
    {sorted.map((a) => (
      <article class="article-card">
        <span class="tag">{a.data.verticalName}</span>
        <h3><a href={`/guides/${v.id}/${a.data.slug}/`}>{a.data.title}</a></h3>
        <p class="excerpt">{a.data.description}</p>
        <p class="date">{a.data.pubDate.toISOString().slice(0, 10)}</p>
      </article>
    ))}
  </div>
</BaseLayout>
